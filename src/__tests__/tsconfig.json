{
	"extends": "../../tsconfig.json",
	"include": [
		".", // Includes all files in the current directory
		"../**/*" // Includes all files in the src directory
	],
	"compilerOptions": {
		"baseUrl": "../",
		// Tests are bundled by vitest, so resolve like a bundler. Classic "node"
		// resolution ignores package.json "exports" and cannot see vitest 4's
		// types (e.g. 'vite/module-runner').
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["node", "vitest/globals"],
		"paths": {
			// @types/send (via express) expects mime@1 types; without this TS
			// picks the hoisted ESM mime@4 (a semantic-release dependency).
			"mime": ["../node_modules/@types/mime"],
			"lib": ["./lib"],
			"oauth": ["./oauth"],
			"operate": ["./operate"],
			"modeler": ["./modeler"],
			"tasklist": ["./tasklist"],
			"optimize": ["./optimize"],
			"c8console": ["./c8console"]
		}
	},
	"exclude": ["node_modules"]
}
